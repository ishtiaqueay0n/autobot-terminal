{
  "name": "autobot-terminal",
  "productName": "Autobot Terminal",
  "version": "0.1.0",
  "description": "Learning terminal with a personal command assistant",
  "homepage": "https://github.com/ishtiaqueay0n/autobot-terminal",
  "license": "MIT",
  "desktopName": "autobot-terminal.desktop",
  "author": {
    "name": "Ishtiaque Hossain Ayon",
    "email": "317405378+ishtiaqueay0n@users.noreply.github.com"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "kb": "node scripts/build-kb.mjs",
    "predev": "node scripts/build-kb.mjs --if-missing",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run kb -- --if-missing && npm run build && playwright test",
    "dist:win": "npm run kb && npm run build && electron-builder --win --x64",
    "dist:linux": "npm run kb && npm run build && electron-builder --linux --x64"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.2",
    "@withfig/autocomplete": "^2.692.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
